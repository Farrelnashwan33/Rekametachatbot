		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"dompurify": "^3.4.17",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.3"
